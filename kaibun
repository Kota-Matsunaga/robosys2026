import sys


def is_palindrome(text: str) -> bool:
    return len(text) > 0 and text == text[::-1]


def main():
    for line in sys.stdin:
        line = line.rstrip("\r\n")
        if is_palindrome(line):
            print(line)


if __name__ == "__main__":
    main()
